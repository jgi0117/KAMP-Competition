# 데이터 및 대용량 파일
data/
*.csv
*.xlsx
*.xls
*.parquet
*.zip
*.tar.gz
*.7z

# 단, reports 하위의 요약 분석 CSV 파일은 버전 관리 허용
!reports/**/*.csv

# 환경 변수 및 개인 설정 파일
.env
.env.local
.vscode/settings.json
.vscode/interpreter-selection-backup.json

# 파이썬 및 가상환경 캐시
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Jupyter Notebook 캐시
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# OS 생성 파일
Thumbs.db
Desktop.ini
.DS_Store
